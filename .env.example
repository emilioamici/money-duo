# Client ID OAuth "Web application" creato in Google Cloud Console.
# E' un identificativo pubblico (non un segreto), ma va comunque tenuto fuori dal repo:
# copia questo file in .env.local e inserisci il tuo valore.
VITE_GOOGLE_CLIENT_ID=

# Notifiche push (facoltative): indirizzo del Worker Cloudflare e chiave pubblica VAPID (vedi worker/README.md)
VITE_PUSH_URL=
VITE_VAPID_PUBLIC_KEY=
